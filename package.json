{
  "name": "prosae",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --import ./scripts/sites-env.mjs ./node_modules/vite/bin/vite.js --host 127.0.0.1 --port 5173",
    "build": "vue-tsc --noEmit && node --import ./scripts/sites-env.mjs ./node_modules/vite/bin/vite.js build",
    "preview": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --port 4173",
    "typecheck": "vue-tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:local": "node scripts/migrate-local.mjs",
    "test:books": "node scripts/validate-books.mjs",
    "test:api": "node scripts/test-api.mjs",
    "install:ci": "node scripts/install-ci.mjs",
    "test:auth": "node scripts/test-auth.mjs",
    "test:admin": "node scripts/test-admin.mjs"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.6.0",
    "lucide-vue-next": "^0.468.0",
    "jszip": "3.10.1",
    "pdfjs-dist": "5.4.624",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "latest",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vue-tsc": "latest",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
